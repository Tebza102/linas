rules_version = '2';

// Lina's Digital Business Platform — Firestore Security Rules (Phase 1)
//
// Architecture: public enquiry submission goes through a validated Vercel
// serverless function (/api/enquiries/create) using the Firebase Admin SDK,
// which bypasses these rules entirely. That is a deliberate choice over
// direct client-side creation: rules cannot rate-limit, cannot run a
// honeypot check, and cannot see request history, so a scripted attacker
// with the (inherently public) client config could otherwise spam the
// collection and generate billed writes with nothing in front of it.
//
// Because of that, `enquiries` and `enquiryActivities` deny ALL direct
// client creates, from both unauthenticated visitors and authenticated
// admin/staff users — the server endpoint is the only writer for new
// enquiries and activity records. Admin/staff use the client SDK only for
// authorised reads and the specific update fields listed below.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function role() {
      return request.auth.token.role;
    }
    function isOwner() {
      return isSignedIn() && role() == 'owner';
    }
    // Developer has full system access — every owner-only capability in
    // this file also applies to developer (the two differ only in how
    // they're labelled in the admin UI, not in what they can do).
    function isDeveloper() {
      return isSignedIn() && role() == 'developer';
    }
    function isOwnerOrDev() {
      return isOwner() || isDeveloper();
    }
    // Read-only observer: may view business data but can never write it —
    // enforced here, not just by hiding buttons in the UI.
    function isObserver() {
      return isSignedIn() && role() == 'observer';
    }
    // "Staff" check also accepts owner/developer, since they have every
    // staff permission plus more. Kept as `isStaff()` rather than renamed
    // to minimise the diff against every existing call site below.
    function isStaff() {
      return isSignedIn() && (role() == 'owner' || role() == 'developer' || role() == 'staff');
    }

    match /enquiries/{enquiryId} {
      // Staff can only read enquiries assigned to them or unassigned ones
      // (so they can see new leads to pick up); owner/developer/observer
      // can read everything (observer is read-only, enforced below).
      allow read: if isOwnerOrDev() || isObserver()
        || (isStaff()
            && (resource.data.assignedOwnerId == request.auth.uid
                || resource.data.assignedOwnerId == null));

      // No client — public or authenticated — creates enquiry documents
      // directly. Only the server endpoint (Admin SDK, bypasses rules).
      allow create: if false;

      // Marking an enquiry as viewed is deliberately kept separate from the
      // sales-status workflow below: it is a single one-way flag (unset ->
      // now), touches no other field, and cannot be used to smuggle a
      // status/money-field change past the stricter checks further down.
      function isViewOnlyUpdate() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedAt'])
          && resource.data.viewedAt == null
          && request.resource.data.viewedAt == request.time;
      }

      // Notification fields (notificationStatus, notificationSentAt,
      // notificationProviderId, notificationLastError, notificationAttempts)
      // are deliberately absent from every allowed-fields list below — they
      // are written only by the server via the Admin SDK, which bypasses
      // these rules entirely. No client, including an owner, can set them
      // through updateDoc.
      function isStandardUpdate() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'status', 'assignedOwnerId', 'nextAction', 'followUpDate',
             'quotedAmount', 'confirmedAmount', 'confirmedAt', 'lostReason',
             'completedAt', 'updatedAt', 'estimatedValue', 'quotationDate'
           ])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.status in [
             'New', 'Contacted', 'Quoted', 'Confirmed', 'In Progress',
             'Completed', 'Lost/Cancelled'
           ]
        // Quoted requires either a numeric value or the explicit
        // pending-value marker — never a silent/blank state.
        && (request.resource.data.status != 'Quoted'
            || request.resource.data.quotedAmount is number
            || request.resource.data.quotedAmount == 'pending')
        // Confirmed requires a numeric confirmed amount and a confirmation
        // timestamp set to server time.
        && (request.resource.data.status != 'Confirmed'
            || (request.resource.data.confirmedAmount is number
                && request.resource.data.confirmedAt == request.time))
        // Completed requires a completion timestamp set to server time.
        && (request.resource.data.status != 'Completed'
            || request.resource.data.completedAt == request.time)
        // Lost/Cancelled requires a non-empty reason.
        && (request.resource.data.status != 'Lost/Cancelled'
            || (request.resource.data.lostReason is string
                && request.resource.data.lostReason.size() > 0))
        // Recording a quoted/confirmed/estimated value is an owner/developer
        // action — staff can move status forward, but cannot themselves
        // set money fields.
        && (
             !('quotedAmount' in request.resource.data.diff(resource.data).affectedKeys())
             && !('confirmedAmount' in request.resource.data.diff(resource.data).affectedKeys())
             && !('estimatedValue' in request.resource.data.diff(resource.data).affectedKeys())
             && !('quotationDate' in request.resource.data.diff(resource.data).affectedKeys())
             || isOwnerOrDev()
           );
      }

      allow update: if isStaff() && (isViewOnlyUpdate() || isStandardUpdate());

      // Enquiries are never permanently deleted from the normal interface.
      allow delete: if false;
    }

    match /enquiryActivities/{activityId} {
      allow read: if isStaff() || isObserver();
      // Only the server or an authenticated staff/owner action can log an
      // activity record, and only as themselves. Activity history is
      // immutable once written — no update, no delete.
      allow create: if isStaff()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if false;
    }

    match /adminUsers/{uid} {
      // Any authenticated admin/staff/observer can read the directory
      // (needed to show "assigned to" names and an assignment picker; the
      // Users module itself is further restricted to owner/developer in
      // the admin UI and by the update rule below).
      allow read: if isStaff() || isObserver();
      // Admin user records are created only by the controlled bootstrap
      // script (Admin SDK, bypasses rules) — never by a client.
      allow create: if false;
      // Owner/developer manage other users' role/active state, but nobody
      // — not even an owner or developer — can change their OWN role or
      // active field. This blocks self role-escalation and self-reactivation.
      // A signed-in user may always update their own lastLoginAt only
      // (used by auth-guard.js) — never any other field on their own doc.
      function isOwnSelfLoginUpdate() {
        return request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLoginAt']);
      }
      allow update: if isOwnSelfLoginUpdate()
        || (isOwnerOrDev()
            && request.auth.uid != uid
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.email == resource.data.email);
      allow delete: if false;
    }

    match /settings/{docId} {
      allow read: if isStaff();
      allow write: if isOwnerOrDev();
    }

    // Bookings are ONLY confirmed/tentative customer calendar events —
    // simplified from an earlier, broader kitchen-operations design (see
    // Decision Log) to match the sales/marketing priority for this phase.
    // No preparation/kitchen fields, no non-customer entry types.
    match /bookings/{bookingId} {
      allow read: if isOwnerOrDev() || isObserver()
        || (isStaff()
            && (resource.data.assignedPerson == request.auth.uid
                || resource.data.assignedPerson == null));

      // Converting a Confirmed enquiry into a booking is an owner/developer action.
      allow create: if isOwnerOrDev()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.eventType in [
             'Wedding', 'Funeral', 'Corporate event', 'Private function',
             'Mobile kitchen service', 'Food delivery/order', 'Other'
           ]
        && request.resource.data.bookingStatus in [
             'Tentative', 'Awaiting deposit', 'Confirmed', 'Completed', 'Cancelled'
           ];

      // Staff may add internal notes only — never the booking status,
      // dates, or customer details.
      function isStaffBookingUpdate() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['internalNotes', 'updatedAt'])
          && request.resource.data.updatedAt == request.time;
      }
      function isOwnerBookingUpdate() {
        return request.resource.data.updatedAt == request.time
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.bookingStatus in [
               'Tentative', 'Awaiting deposit', 'Confirmed', 'Completed', 'Cancelled'
             ];
      }
      allow update: if (isOwnerOrDev() && isOwnerBookingUpdate()) || (isStaff() && isStaffBookingUpdate());

      allow delete: if isOwnerOrDev();
    }

    // Marketing content calendar (Instagram/Facebook/Google Business
    // Profile/Website/WhatsApp posts). Owner has full control; staff may
    // only move a piece of content they're assigned through its status —
    // never edit its actual content, caption or schedule.
    match /contentItems/{contentId} {
      allow read: if isStaff() || isObserver();

      allow create: if isOwnerOrDev()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.platform in ['Instagram', 'Facebook', 'Google Business Profile', 'Website', 'WhatsApp']
        && request.resource.data.status in ['Idea', 'Draft', 'Ready', 'Scheduled', 'Published', 'Cancelled'];

      function isStaffContentUpdate() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'publishedDate'])
          && request.resource.data.updatedAt == request.time
          && request.resource.data.status in ['Idea', 'Draft', 'Ready', 'Scheduled', 'Published', 'Cancelled']
          && resource.data.assignedPerson == request.auth.uid;
      }
      function isOwnerContentUpdate() {
        return request.resource.data.updatedAt == request.time
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.platform in ['Instagram', 'Facebook', 'Google Business Profile', 'Website', 'WhatsApp']
          && request.resource.data.status in ['Idea', 'Draft', 'Ready', 'Scheduled', 'Published', 'Cancelled'];
      }
      allow update: if (isOwnerOrDev() && isOwnerContentUpdate()) || (isStaff() && isStaffContentUpdate());
      allow delete: if isOwnerOrDev();
    }

    // Campaigns are owner/developer-managed; staff and observer can read
    // them for lead context (e.g. seeing which campaign a lead came from)
    // but never edit them.
    match /campaigns/{campaignId} {
      allow read: if isStaff() || isObserver();
      allow create: if isOwnerOrDev()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.status in ['Planned', 'Active', 'Paused', 'Completed'];
      allow update: if isOwnerOrDev()
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status in ['Planned', 'Active', 'Paused', 'Completed'];
      allow delete: if isOwnerOrDev();
    }

    // Quotations and invoices are financial records — owner/developer can
    // read and write end to end; observer can view but never write; staff
    // has no access to financial records at all.
    match /quotations/{quoteId} {
      allow read: if isOwnerOrDev() || isObserver();
      allow create: if isOwnerOrDev()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.status in ['Draft', 'Sent', 'Accepted', 'Declined', 'Expired', 'Revised'];
      allow update: if isOwnerOrDev()
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.enquiryId == resource.data.enquiryId
        && request.resource.data.status in ['Draft', 'Sent', 'Accepted', 'Declined', 'Expired', 'Revised'];
      allow delete: if isOwnerOrDev();
    }

    match /invoices/{invoiceId} {
      allow read: if isOwnerOrDev() || isObserver();
      allow create: if isOwnerOrDev()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.status in ['Draft', 'Sent', 'Partially Paid', 'Paid', 'Overdue', 'Cancelled'];
      allow update: if isOwnerOrDev()
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.enquiryId == resource.data.enquiryId
        && request.resource.data.status in ['Draft', 'Sent', 'Partially Paid', 'Paid', 'Overdue', 'Cancelled'];
      allow delete: if isOwnerOrDev();
    }

    // Per-day reference-number counters are written only by the server
    // endpoint via the Admin SDK. No client ever needs to touch them.
    match /counters/{counterId} {
      allow read, write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
