# Allowlist model: deny everything by default, then re-admit only the exact
# files the live site needs. A deny-list only protects against folders we
# thought to name — this fails closed if something new and unreviewed is
# added later.
#
# Everything NOT listed below stays out of the public deployment, including
# (but not limited to): docs/, scripts/ (local dev tooling, not the /api
# functions), data/, the control-pack zip, the client working-model demo
# (backend-dependent, not deployable), raw client-source uploads
# (assets/source/social, assets/source/menu, assets/source/documents),
# internal design-direction/rationale docs, the rejected V1 prototype, the
# unlinked "concept-2" landing variant, internal review screenshots/video
# contact sheets, unused brand/media files, and all Firebase project/rules
# config (firebase.json, firestore.rules, .firebaserc, firestore.indexes.json
# — deployed separately via `firebase deploy`, not part of the Vercel site).

/*
!/assets
!/api
!/admin
!/package.json
!/package-lock.json

/assets/*
!/assets/mockups
!/assets/source

/assets/mockups/*
!/assets/mockups/working

/assets/mockups/working/*
!/assets/mockups/working/prototype-v2
!/assets/mockups/working/media

/assets/mockups/working/prototype-v2/*
!/assets/mockups/working/prototype-v2/index.html
!/assets/mockups/working/prototype-v2/catering.html
!/assets/mockups/working/prototype-v2/menu.html
!/assets/mockups/working/prototype-v2/chef-lina.html
!/assets/mockups/working/prototype-v2/mobile-kitchen.html
!/assets/mockups/working/prototype-v2/gallery.html
!/assets/mockups/working/prototype-v2/contact.html
!/assets/mockups/working/prototype-v2/styles.css
!/assets/mockups/working/prototype-v2/script.js
!/assets/mockups/working/prototype-v2/menu-data.js
!/assets/mockups/working/prototype-v2/enquiry-submit.js
!/assets/mockups/working/prototype-v2/public-admin-link.js

/assets/mockups/working/media/*
!/assets/mockups/working/media/lina-catering-preview-working-v1-20260728.mp4
!/assets/mockups/working/media/lina-chef-trailer-frame-working-v1-20260728.jpg
!/assets/mockups/working/media/lina-gallery-clip-01-working-v1-20260728.mp4
!/assets/mockups/working/media/lina-gallery-frame-02-working-v1-20260728.jpg
!/assets/mockups/working/media/lina-gallery-frame-03-working-v1-20260728.jpg
!/assets/mockups/working/media/lina-gallery-frame-04-working-v1-20260728.jpg
!/assets/mockups/working/media/lina-gallery-frame-05-signage-working-v1-20260728.jpg
!/assets/mockups/working/media/lina-hero-poster-working-v1-20260728.jpg
!/assets/mockups/working/media/lina-hero-preview-working-v1-20260728.mp4
!/assets/mockups/working/media/lina-mobilekitchen-preview-working-v1-20260728.mp4
!/assets/mockups/working/media/lina-logo-header-working-v1-20260731.jpg
!/assets/mockups/working/media/lina-preparation-frame-working-v1-20260728.jpg

/assets/source/*
!/assets/source/brand

/assets/source/brand/*
!/assets/source/brand/Linas_Favicon.jpg

# Inside /api and /admin everything is legitimate application source (no
# unrelated sibling content the way assets/ has), so no further per-file
# restriction is needed once the directory itself is admitted above. Local
# secrets can never leak here regardless, since .env*/.secrets/service
# account files are excluded by .gitignore before they'd ever reach Git,
# let alone a Vercel upload.
