# Lina project — local environment artifacts only.
# Do NOT add broad rules that ignore assets/, docs/, or the prototype/screenshots —
# see docs/LINA-ASSET-REGISTER.md and CLAUDE.md for why those must stay tracked.

# Node
node_modules/
npm-debug.log*
.npm/

# OS-generated files
Thumbs.db
desktop.ini
.DS_Store

# Editor/IDE
.vscode/*
!.vscode/extensions.json

# Local server logs, if ever redirected to a file
*.local.log

# Local demo database (scripts/serve-demo.js) — runtime data generated by
# testing/demoing the enquiry -> admin -> dashboard flow, not source content.
data/*.db

# Vercel CLI project link/config (local machine + Vercel-account specific,
# never shared source content).
.vercel
.env*
