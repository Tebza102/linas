# Lina's platform — required environment variables.
# Copy to .env.local for local testing of api/enquiries/create.js (never
# commit .env.local — it is gitignored). In Vercel, set these under
# Project Settings -> Environment Variables (Production + Preview), never
# in frontend code.
#
# These three values come from a Firebase Admin SDK service-account key
# generated in the Firebase Console (Project Settings -> Service accounts
# -> Generate new private key) for the "lina-s" project. See the manual
# setup instructions in the delivery report for exact steps.

# The "client_email" field from the downloaded service-account JSON.
FIREBASE_CLIENT_EMAIL=service-account@lina-s.iam.gserviceaccount.com

# The "private_key" field from the downloaded service-account JSON.
# Keep the \n line-break sequences literal (do not convert to real
# newlines) — the server code un-escapes them at runtime.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPLACEHOLDER\n-----END PRIVATE KEY-----\n"

# The Firebase/GCP project ID (matches .firebaserc's "default" project).
FIREBASE_PROJECT_ID=lina-s

# Operational enquiry-notification email, sent via SMTP (api/_lib/mail.js).
# Server-side only — never referenced from browser code.

# Your mail provider's SMTP hostname (e.g. EliteHost's mail server address).
SMTP_HOST=mail.example.com

# 465 (implicit TLS) or 587 (STARTTLS) are the usual choices — check with
# your host. Must be a number.
SMTP_PORT=587

# The mailbox username used to authenticate with the SMTP server.
SMTP_USER=enquiries@example.com

# The mailbox password. Never commit the real value — this file only ever
# holds a placeholder.
SMTP_PASSWORD=PLACEHOLDER

# Display name and address used in the "From" header of every email sent.
SMTP_FROM_NAME=Lina's
SMTP_FROM_EMAIL=enquiries@example.com

# Where new-enquiry notification emails are sent (an internal address you
# monitor, not a customer-facing one).
ENQUIRY_NOTIFICATION_TO=owner@example.com

# The WhatsApp number orders/enquiries are sent to, digits only with country
# code (no +, no spaces). Falls back to 27764834344 if unset.
LINA_WHATSAPP_NUMBER=27764834344

# Version tag recorded against POPIA consent at the moment it was given.
PRIVACY_NOTICE_VERSION=v1-draft

# --- Coming Soon / private preview gate (docs/LINA-COMING-SOON-MODE.md) ---
# See that file before changing any of these in a real deployment.

# "true" to show the public gate; anything else (or unset) is full
# passthrough — the live site behaves exactly as if this feature didn't exist.
COMING_SOON_ENABLED=false

# Shared password given only to named reviewers. Never reused as any other
# secret in this project.
COMING_SOON_REVIEWER_PASSWORD=PLACEHOLDER

# Signs the private-preview cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
COMING_SOON_COOKIE_SECRET=PLACEHOLDER

# Bump this (any new value) to instantly invalidate every outstanding
# reviewer/developer preview cookie, with no code change or redeploy.
COMING_SOON_ACCESS_VERSION=1

# Optional. ISO 8601 with an explicit UTC offset. Absent/invalid = the
# countdown stays hidden — never a fabricated date. Once set, this also
# drives AUTOMATIC LAUNCH: the gate opens itself the moment the server
# clock reaches this instant — no redeploy needed at launch time.
COMING_SOON_LAUNCH_AT=

# Emergency brake for automatic launch. "true" keeps the gate closed even
# after COMING_SOON_LAUNCH_AT has passed, without touching that value (the
# countdown keeps showing the correct date; only enforcement pauses).
# Leave unset/false in normal operation.
COMING_SOON_LAUNCH_HOLD=false

# Optional launch-special banner. Both must be set together; leave
# PROMO_ENABLED false until the client has approved real promo copy.
COMING_SOON_PROMO_ENABLED=false
COMING_SOON_PROMO_TEXT=
